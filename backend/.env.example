# Copy this file to ".env" in the same folder before starting the server.
# The start scripts (start.sh / start.bat) will create .env from this file
# automatically on first run if it doesn't already exist.

# Port the server runs on. The app will be available at http://localhost:PORT
PORT=3000

# Secret used to sign login sessions (JWT). Change this to a long random
# string before sharing or deploying this app anywhere beyond your own machine.
JWT_SECRET=change-this-to-a-long-random-secret-before-going-live

# Optional: enable the "Ask LifeLoop" chatbot.
# LifeLoop works out of the box with a smart built-in recommendation engine
# for scanning (no key needed). If you add a Gemini API key here, the 
# "Ask LifeLoop" chatbot on an item's detail page can provide deeper AI 
# analysis for queries. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use, if GEMINI_API_KEY is set. Must be a
# model that supports image input. Google's free-tier model lineup changes
# over time — check https://ai.google.dev/pricing for what's currently free
# and update this if needed. gemini-3.6-flash is a reasonable default as of
# this writing.
GEMINI_MODEL=gemini-flash-latest

# Required: Supabase Connection Details
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required: Cloudinary URL for persistent image uploads on Vercel.
# Format: cloudinary://my_key:my_secret@my_cloud_name
CLOUDINARY_URL=

# Optional: which AI provider to use. Only "gemini" is implemented today;
# this exists so a future provider can be added and selected here without
# any other code changes.
AI_PROVIDER=gemini

# Optional: override where OCR (text-extraction) language data is downloaded
# from on first use. You shouldn't need to change this unless the default
# source becomes unavailable.
# OCR_LANG_DATA_URL=https://raw.githubusercontent.com/naptha/tessdata/gh-pages/4.0.0_best

# Optional: look up a product by its decoded QR code against your own
# product database API. LifeLoop does not call any external barcode
# database by default — there's no broadly reliable, free one to point to.
# If you have one, put its URL here with {code} where the scanned code
# should be inserted, e.g.: https://api.example.com/products/{code}
BARCODE_LOOKUP_API_URL=

# ---------------------------------------------------------
# Production Deployment Config
# ---------------------------------------------------------

# Set to "production" when deploying to a real server. This enables 
# secure session cookies (HTTPS only) and disables dev-specific behaviors.
# NODE_ENV=production

# CRITICAL for production deployment: LifeLoop stores all data and uploaded
# photos locally as files. If deploying to an ephemeral environment (like
# Railway, Heroku, or Docker), you MUST mount a persistent volume and
# point these variables to that volume's path to avoid data loss.
# DATA_DIR=/path/to/persistent/volume/data
# UPLOADS_DIR=/path/to/persistent/volume/uploads
